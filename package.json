{
  "name": "Neptun Plus",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check": "i18n-check --locales src/locales --source en --format i18next",
    "build:css": "sass --no-source-map --style=compressed src/styles:src/styles",
    "watch:css": "sass --watch --no-source-map --style=compressed src/styles:src/styles"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@lingual/i18n-check": "^0.9.5",
    "@types/chrome": "^0.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.5",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
